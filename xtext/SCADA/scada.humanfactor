
HFMeasurementLibrary SCADA_MeasurementsLibrary {
	measurements Skill {
		HFMeasurementScale Skill_Scale : interval 
		hasValuesOfType Quantitative 
		acceptedValues { Skill_Scale_1 Skill_Scale_2 Skill_Scale_3 Skill_Scale_4 Skill_Scale_5}
	}
	values {
		HFMeasurementValue Skill_Scale_1 = 1 
		HFMeasurementValue Skill_Scale_2 = 2
		HFMeasurementValue Skill_Scale_3 = 3
		HFMeasurementValue Skill_Scale_4 = 4
		HFMeasurementValue Skill_Scale_5 = 5
	}
	
	measurements Experience {
		HFMeasurementScale Experience_Scale : interval 
		hasValuesOfType Quantitative 
		acceptedValues { Experience_Scale_1 Experience_Scale_2 Experience_Scale_3 Experience_Scale_4 Experience_Scale_5}
	}
	values {
		HFMeasurementValue Experience_Scale_1 = 0
		HFMeasurementValue Experience_Scale_2 = 2
		HFMeasurementValue Experience_Scale_3 = 4
		HFMeasurementValue Experience_Scale_4 = 8
		HFMeasurementValue Experience_Scale_5 = 10
	}
}

HFCategoryLibrary SCADA_Category_Library {
	HFCategory DirectFactor 
	{
		HFCategory Skill
		HFCategory Experience
	} 
}

HFPropertyLibrary SCADA_Property_Library { 
	
	HFProperty Skill_Authentication_AC 
		isIn SCADA_Category_Library.DirectFactor.Skill
		isMeasuredWith SCADA_MeasurementsLibrary.Skill.Skill_Scale
		refersTo "Authentication_Active_Component"
	HFProperty Experience_Authentication_AC
		isIn SCADA_Category_Library.DirectFactor.Experience
		isMeasuredWith SCADA_MeasurementsLibrary.Experience.Experience_Scale
		refersTo "Authentication_Active_Component"
			
	HFProperty Skill_Authorization_AC
		isIn SCADA_Category_Library.DirectFactor.Skill
		isMeasuredWith SCADA_MeasurementsLibrary.Skill.Skill_Scale
		refersTo "Authorization_Active_Component"	
	HFProperty Experience_Authorization_AC
		isIn SCADA_Category_Library.DirectFactor.Experience
		isMeasuredWith SCADA_MeasurementsLibrary.Experience.Experience_Scale
		refersTo "Authorization_Active_Component" 
}

